{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "module_c_urban_rule ruleset",
  "description": "Module C 임계값·출처 룰셋. contracts/의 계약 파일이 아니라 트랙② 내부 정책 파일이므로 4인 합의 없이 수정 가능하다 — 단 판정 결과가 바뀌므로 스냅샷 테스트를 함께 갱신할 것.",
  "type": "object",
  "required": [
    "ruleset_version",
    "description",
    "rows"
  ],
  "properties": {
    "ruleset_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "status",
          "source",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PLACEHOLDER",
              "DERIVED",
              "CONFIRMED",
              "CONFIRMED_COMPONENT",
              "POLICY_CONFIRMED_DIRECTION"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "agency",
              "document",
              "clause",
              "url",
              "retrieved"
            ],
            "properties": {
              "agency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "document": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "clause": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrieved": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "corroborating_sources": {
            "type": "array",
            "description": "1차 자료(기관 원문) URL을 아직 확보하지 못했을 때의 보도 확인 근거. source를 대체하지 않는다.",
            "items": {
              "type": "object",
              "required": [
                "outlet",
                "title",
                "published",
                "url",
                "retrieved",
                "quote"
              ],
              "properties": {
                "outlet": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "published": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "retrieved": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
