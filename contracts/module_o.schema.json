{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "module_o_orchestrator",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["alert_id", "trigger_location", "timestamp", "auto_approve_timeout_min", "safety_margin_hours"],
      "properties": {
        "alert_id": { "type": "string" },
        "trigger_location": {
          "type": "object",
          "required": ["x_5179", "y_5179"],
          "properties": { "x_5179": { "type": "number" }, "y_5179": { "type": "number" } }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "auto_approve_timeout_min": { "type": "integer" },
        "safety_margin_hours": { "type": "number" }
      }
    },
    "output": {
      "type": "object",
      "required": ["status", "fallback_tier", "data", "warnings"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "degraded", "error"] },
        "fallback_tier": { "type": "integer", "enum": [1, 2, 3] },
        "data": {
          "type": "object",
          "required": ["timeline_actual", "timeline_agent", "golden_time_saved_min", "approval_status", "citizen_verification", "alert_package"],
          "properties": {
            "timeline_actual": {
              "type": "object",
              "properties": {
                "advisory": { "type": "string", "format": "date-time" },
                "report_start": { "type": "string", "format": "date-time" },
                "warning_escalated": { "type": "string", "format": "date-time" }
              }
            },
            "timeline_agent": {
              "type": "object",
              "properties": {
                "detected": { "type": "string", "format": "date-time" },
                "alert_sent": { "type": "string", "format": "date-time" }
              }
            },
            "golden_time_saved_min": { "type": "number" },
            "approval_status": { "type": "string", "enum": ["대기", "승인", "거부", "자동승인(timeout)"] },
            "citizen_verification": {
              "type": "object",
              "properties": {
                "verification_status": { "type": "string", "enum": ["미확인", "현장확인", "오탐판정"] },
                "confidence_adjustment": { "type": "number" }
              }
            },
            "alert_package": {
              "type": "object",
              "properties": {
                "landslide": { "type": "object" },
                "flood": { "type": "object" },
                "shelter_route": { "type": "object" },
                "damage_cost": { "type": "object" }
              }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approve_endpoint": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "const": "POST" },
        "path": { "type": "string", "const": "/approve/{alert_id}" },
        "request_body": {
          "type": "object",
          "required": ["decision", "approver_id"],
          "properties": {
            "decision": { "type": "string", "enum": ["승인", "거부"] },
            "approver_id": { "type": "string" }
          }
        }
      }
    }
  }
}
