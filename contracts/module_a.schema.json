{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "module_a_landslide",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["x_5179", "y_5179", "timestamp", "static", "dynamic"],
      "properties": {
        "x_5179": { "type": "number" },
        "y_5179": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "static": {
          "type": "object",
          "required": ["slope_deg", "curvature", "twi", "aspect_deg", "dnbr", "dnbr_class", "days_since_fire"],
          "properties": {
            "slope_deg": { "type": "number" },
            "curvature": { "type": "number" },
            "twi": { "type": "number" },
            "aspect_deg": { "type": "number", "minimum": 0, "maximum": 360 },
            "dnbr": { "type": "number" },
            "dnbr_class": { "type": "string", "enum": ["none", "low", "moderate", "high"] },
            "days_since_fire": { "type": ["integer", "null"] }
          }
        },
        "dynamic": {
          "type": "object",
          "required": ["rainfall_1h_mm", "rainfall_cumulative_24h_mm", "rainfall_cumulative_72h_mm", "api_index", "source"],
          "properties": {
            "rainfall_1h_mm": { "type": "array", "items": { "type": "number" } },
            "rainfall_cumulative_24h_mm": { "type": "number" },
            "rainfall_cumulative_72h_mm": { "type": "number" },
            "api_index": { "type": "number" },
            "source": { "type": "string", "enum": ["observed", "forecast"] }
          }
        },
        "insar_displacement_mm_per_day": { "type": ["number", "null"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["status", "fallback_tier", "data", "warnings"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "degraded", "error"] },
        "fallback_tier": { "type": "integer", "enum": [1, 2, 3] },
        "data": {
          "type": "object",
          "required": ["landslide_prob", "confidence_interval", "source", "amplification_factor", "precursor_flag", "hours_to_critical", "location"],
          "properties": {
            "landslide_prob": { "type": "number", "minimum": 0, "maximum": 1 },
            "confidence_interval": {
              "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2
            },
            "source": { "type": "string", "enum": ["observed", "forecast"] },
            "amplification_factor": { "type": "number" },
            "precursor_flag": { "type": "boolean" },
            "hours_to_critical": { "type": ["number", "null"] },
            "location": {
              "type": "object",
              "required": ["x_5179", "y_5179"],
              "properties": { "x_5179": { "type": "number" }, "y_5179": { "type": "number" } }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
